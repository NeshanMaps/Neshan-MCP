# --- API key (stdio fallback) ---
# In HTTP mode the client sends the key in the 'Neshan-Api-Key' header.
# These env vars are used as a fallback (mainly for stdio / Claude Desktop).
# Default key (used for all services unless overridden below).
NESHAN_API_KEY=your_api_key_here

# --- Optional: service-scoped keys ---
# Neshan keys are scoped per service. If your keys differ per service,
# set the relevant ones; otherwise NESHAN_API_KEY is used as fallback.
# NESHAN_KEY_SEARCH=
# NESHAN_KEY_GEOCODING=
# NESHAN_KEY_ROUTING=
# NESHAN_KEY_MATRIX=
# NESHAN_KEY_TSP=
# NESHAN_KEY_STATIC=
# NESHAN_KEY_MAP_MATCHING=

# --- Optional: runtime ---
# Transport: 'stdio' (default, for Claude Desktop/Cursor) or 'http'
NESHAN_TRANSPORT=stdio
NESHAN_HOST=127.0.0.1
NESHAN_PORT=3000
NESHAN_TIMEOUT=15
NESHAN_MAX_RETRIES=2
NESHAN_LOG_LEVEL=INFO

# --- Optional: overrides ---
# NESHAN_BASE_URL=https://api.neshan.org
# NESHAN_MAP_MATCHING_PATH=/mapMatching/v1/snapToRoad
